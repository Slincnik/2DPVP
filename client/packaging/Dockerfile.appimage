# Build on Ubuntu 22.04 so the AppImage remains compatible with glibc 2.35.
FROM ubuntu:22.04 AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG GATEWAY_URL
ARG PVP_DUEL_VERSION=0.0.0-dev
ARG PVP_DUEL_UPDATE_MANIFEST_URL=
ARG MSQUIC_VERSION=2.5.7
ARG LINUXDEPLOY_VERSION=1-alpha-20251107-1
ARG LINUXDEPLOY_SHA256=c20cd71e3a4e3b80c3483cef793cda3f4e990aca14014d23c544ca3ce1270b4d

RUN apt-get update && apt-get install -y --no-install-recommends \
        binutils build-essential ca-certificates curl dpkg-dev file git \
        libasound2-dev libgl1-mesa-dev libnuma-dev libprotobuf-dev libsecret-1-dev libssl-dev \
        libx11-dev libxcursor-dev libxext-dev libxfixes-dev libxi-dev \
        libxinerama-dev libxrandr-dev ninja-build patchelf pkg-config \
        protobuf-compiler python3-pip && \
    python3 -m pip install --no-cache-dir cmake==3.31.6 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# Generate C++ bindings with Jammy's protoc/runtime pair, instead of using
# bindings generated by the newer host toolchain.
RUN rm -rf client/proto && mkdir -p client/proto && \
    protoc -I proto --cpp_out=client/proto proto/game/v1/duel.proto

# Use Microsoft's Jammy package, not the host's Debian Trixie package. This is
# essential: the latter itself requires glibc 2.38.
RUN set -eux; \
    arch=amd64; \
    mkdir -p .deps/msquic/include /tmp/msquic; \
    curl -fsSL "https://packages.microsoft.com/ubuntu/22.04/prod/pool/main/libm/libmsquic/libmsquic_${MSQUIC_VERSION}_${arch}.deb" -o /tmp/msquic/libmsquic.deb; \
    dpkg-deb -x /tmp/msquic/libmsquic.deb .deps/msquic; \
    curl -fsSL "https://raw.githubusercontent.com/microsoft/msquic/v${MSQUIC_VERSION}/src/inc/msquic.h" -o .deps/msquic/include/msquic.h; \
    curl -fsSL "https://raw.githubusercontent.com/microsoft/msquic/v${MSQUIC_VERSION}/src/inc/msquic_posix.h" -o .deps/msquic/include/msquic_posix.h; \
    curl -fsSL "https://raw.githubusercontent.com/microsoft/msquic/v${MSQUIC_VERSION}/src/inc/quic_sal_stub.h" -o .deps/msquic/include/quic_sal_stub.h; \
    rm -rf /tmp/msquic /var/lib/apt/lists/*

RUN cmake -S client -B /build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DPVP_DUEL_REQUIRE_SECURE_STORAGE=ON \
      -DPVP_DUEL_VERSION="${PVP_DUEL_VERSION:-0.0.0-dev}" \
      -DPVP_DUEL_UPDATE_MANIFEST_URL="${PVP_DUEL_UPDATE_MANIFEST_URL:-}" && \
    cmake --build /build --parallel && \
    ctest --test-dir /build --output-on-failure

RUN set -eux; \
    test -n "$GATEWAY_URL"; \
    case "$GATEWAY_URL" in http://*|https://*) ;; *) exit 2 ;; esac; \
    case "$GATEWAY_URL" in *"'"*|*[[:space:]]*) exit 2 ;; esac; \
    mkdir -p /build/AppDir/usr/bin /out; \
    printf '%s\n' \
      '#!/bin/sh' \
      'if [ -z "${GATEWAY_URL:-}" ]; then' \
      "  GATEWAY_URL='$GATEWAY_URL'" \
      'fi' \
      'export GATEWAY_URL' \
      'appdir="${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)}"' \
      'export PVP_DUEL_UPDATER_PATH="$appdir/usr/bin/pvp_duel_updater"' \
      'exec "$appdir/usr/bin/pvp_duel_client" "$@"' \
      > /build/AppDir/usr/bin/pvp-duel-launcher; \
    chmod +x /build/AppDir/usr/bin/pvp-duel-launcher; \
    curl -fL "https://github.com/linuxdeploy/linuxdeploy/releases/download/${LINUXDEPLOY_VERSION}/linuxdeploy-x86_64.AppImage" -o /tmp/linuxdeploy; \
    echo "${LINUXDEPLOY_SHA256}  /tmp/linuxdeploy" | sha256sum --check --status; \
    chmod +x /tmp/linuxdeploy; \
    ARCH=x86_64 LDAI_OUTPUT=/out/PvPDuel-x86_64.AppImage /tmp/linuxdeploy --appimage-extract-and-run \
      --appdir /build/AppDir \
      --executable /build/pvp_duel_client \
      --executable /build/pvp_duel_updater \
      --desktop-file /src/client/packaging/pvp-duel.desktop \
      --icon-file /src/client/packaging/pvp-duel.svg \
      --output appimage; \
    chmod +x /out/PvPDuel-x86_64.AppImage

# Fail the build if host contamination raises the compatibility floor.
RUN set -eux; \
    max_glibc="$(objdump -T /build/pvp_duel_client | grep -o 'GLIBC_[0-9.]*' | sort -V | tail -1)"; \
    test "$(printf '%s\n' GLIBC_2.35 "$max_glibc" | sort -V | tail -1)" = GLIBC_2.35; \
    echo "Compatibility floor verified: ${max_glibc}"

FROM scratch AS artifact
COPY --from=builder /out/PvPDuel-x86_64.AppImage /
